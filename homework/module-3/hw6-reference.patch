# Reference Homework 6 mechanics needed to begin Homework 7.
#
# Apply this patch only if you did not finish Homework 6:
#
#     git apply homework/module-3/hw6-reference.patch
#
# The patch implements the pass metrics and completes the Harbor workflow.
# It does not invent baseline classifications, GitHub run URLs, or model
# results. Keep your own evaluation cases and observed results when you
# completed Homework 6.
diff --git a/.github/workflows/evals.yml b/.github/workflows/evals.yml
index 3f9d3b8..44c2952 100644
--- a/.github/workflows/evals.yml
+++ b/.github/workflows/evals.yml
@@ -34,10 +34,25 @@ jobs:
           lfs: true
       - uses: astral-sh/setup-uv@v5
       - run: uv sync
-
-      # Homework 6: install Harbor 0.23.0.
-      # Generate the classified tasks in eval_cases/cases.jsonl.
-      # Run five attempts per task in fresh Docker containers.
-      # Pass the agent and judge provider keys to Harbor.
-      # Summarize the job and upload the job files with `if: always()` so a
-      # failed regression keeps its evidence.
+      - run: uv tool install 'harbor==0.23.0'
+      - run: uv run python scripts/export_harbor_tasks.py
+      - name: Run Harbor evaluations
+        run: |
+          harbor run \
+            -p .harbor/tasks \
+            -a harbor_adapter.agent:OaklineAgent \
+            -m "$OAKLINE_MODEL" \
+            -e docker \
+            --n-attempts 5 \
+            --job-name hw6-evals \
+            --jobs-dir .harbor/jobs \
+            --yes
+      - name: Summarize results
+        if: always()
+        run: uv run python scripts/summarize_harbor_job.py .harbor/jobs/hw6-evals --expected-attempts 5
+      - name: Upload Harbor job
+        if: always()
+        uses: actions/upload-artifact@v4
+        with:
+          name: hw6-evals
+          path: .harbor/jobs/hw6-evals

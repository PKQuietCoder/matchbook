# Copy to .env and fill in what you have. .env is gitignored; never commit it,
# and never paste a key into a chat or a commit message.

# The only key Matchbook can use. Needed for `--model claude-sonnet-5`, and for
# nothing else: the mining half, the bridge and the scripted agent sessions all
# run without it, which is enforced by tests/test_offline_mining.py.
ANTHROPIC_API_KEY=

# Optional. Point the agent at a scratch world so a live run does not mutate
# data/matchbook.db. Defaults to data/matchbook.db.
# MB_DB=

# Optional. Defaults to data/policies.
# MB_POLICIES_DIR=

# -- the local trace stack (Homework 2 onwards) --------------------------------
# Matchbook records every run to SQLite regardless; these only decide whether
# the same run is also readable in a trace UI. Unset, instrument.py records
# nothing and every command still works.
#
#   docker compose -f observability/docker-compose.yml up -d
#   http://localhost:3001  ->  student@example.com / matchbook-dev-pass
#
# Port 3001, not 3000: the upstream default is 3000, and every port in
# Matchbook's stack is shifted by one so it can coexist with another instance.
#
# The keys below are seeded into the local container at first boot. They are
# development credentials for a service on your own machine, not secrets.
LANGFUSE_HOST=http://localhost:3001
LANGFUSE_PUBLIC_KEY=pk-lf-matchbook-dev
LANGFUSE_SECRET_KEY=sk-lf-matchbook-dev

# Whether spans carry message text. Off by default: the span tree, tool order,
# roles, permission decisions and token counts are recorded either way, but the
# message text that Module 2's trace review needs is not. Keep it off when
# content must not leave the machine, and redact before exporting traces.
MB_TRACE_CONTENT=true

# Signs the dev session tokens issued by server/app.py. Local development only;
# the token exists so the endpoint can tell identity it established itself from
# identity merely claimed in a conversation.
MB_SESSION_SECRET=matchbook-dev-session-secret
